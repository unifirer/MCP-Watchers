# Generated runtime state - never commit
logs/
temp/
*.log
*.err
*.lock
teardown-state.json
launcher-state.json
.launcher/
.grepai/
.memdb/
.memtrace/
*-out/
graphify-out/
graphenium-out/
repowise-out/

# Panes and scratch
.panes/
panes/
tail_*.ps1

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# repowise API keys (local)
.repowise/.env
# repowise scratch residue (mcpw-05o): `.update.lock.<pid>.<n>.tmp` is left
# behind when an update is interrupted, and `*.pkltmp` is an interrupted pickle
# cache write. Both are never tracked, and they otherwise bury genuine untracked
# files in `git status`.
.repowise/*.tmp
.repowise/*.pkltmp
.repowise/.update.lock.*
